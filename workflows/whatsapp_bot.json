    {
      "parameters": {
        "jsCode": "const lastProcessed = Number(\n  $('fetch_last_batch_markers ').first().json.last_whatsapp_notification_sent_row || 0\n);\n\nconst output = [];\n\nfor (const item of $('fetch_required_data').all()) {\n  const row = item.json;\n\n  if (Number(row.form_response_row_number || 0) > lastProcessed) {\n    output.push(item);\n  }\n}\n\nreturn output;"
