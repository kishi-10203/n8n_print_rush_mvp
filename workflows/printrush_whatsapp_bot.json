    {
      "parameters": {
        "jsCode": "const rows = $('fetch_processed_orders').all().map(item => item.json);\n\nlet last_whatsapp_notification_sent_row = 0;\n\nfor (const row of rows) {\n  const rowNum = row.form_response_row_number;\n\n  if (rowNum == null) {\n    continue;\n  }\n\n  last_whatsapp_notification_sent_row = Math.max(\n    last_whatsapp_notification_sent_row,\n    Number(rowNum)\n  );\n}\n\nreturn [\n  {\n    json: {\n      last_whatsapp_notification_sent_row,\n    },\n  },\n];"
      },
